# SmartBin+ Environment Variables
#
# ── FRONTEND (Vite / React — prefix VITE_) ─────────────────────────────────
# These are exposed to the browser bundle.
# Get all values from: Firebase Console → Project Settings → General → Your apps → SDK config
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" for live IoT mode. Set to "true" to force demo/simulation mode.
# If Firebase keys above are empty, the app automatically enters DEMO DATA mode.
VITE_SMARTBIN_DEMO_MODE=false

# ── BACKEND / SERVER (Vercel Serverless — NOT exposed to browser) ───────────
# These are only read by api/telemetry.ts on the server.

# Firebase Realtime Database URL (e.g. https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app)
FIREBASE_DATABASE_URL=

# Firebase service account JSON (single-line, with escaped quotes)
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared secret between the server and ESP32 firmware.
# The firmware sends this in the X-API-Key header.
# The server validates it. Use a strong random string (32+ chars).
IOT_DEVICE_API_KEY=
