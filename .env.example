# ─────────────────────────────────────────────────────────────
# SmartBin+ — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── DATA MODE ────────────────────────────────────────────────
# real        ESP32 telemetry only. A bin that has never reported shows
#             "Waiting for device" — never a fabricated percentage.
# simulation  Generated data for development without hardware. The UI shows
#             a SIMULATION badge the whole time.
#
# Anything other than "simulation" — including unset — is REAL.
VITE_DATA_MODE=real

# ── FIREBASE ─────────────────────────────────────────────────
# Firebase Console → Project settings → General → "Your apps" → Web app.
# The database URL is at the top of Realtime Database → Data.
#
# These values are PUBLIC by design — a web app ships them to the browser.
# What protects the data is Authentication plus the rules in
# firebase-rules.json, not secrecy of the API key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── DEVICE LIVENESS ──────────────────────────────────────────
# How often the ESP32 transmits. Must match UPLOAD_INTERVAL_MS in
# firmware/smartbin_esp32/config.h.
VITE_TELEMETRY_INTERVAL_MS=15000

# No telemetry for this long and the bin shows OFFLINE.
# Keep it at roughly 3× the transmit interval so one dropped packet or a
# Wi-Fi reconnect does not make a healthy bin flicker offline.
VITE_DEVICE_OFFLINE_TIMEOUT_MS=50000

# ─────────────────────────────────────────────────────────────
# NOT stored here — these live in firmware/smartbin_esp32/config.h,
# which is flashed to the device and must stay out of git:
#   WIFI_SSID · WIFI_PASSWORD · DEVICE_EMAIL · DEVICE_PASSWORD
# ─────────────────────────────────────────────────────────────
