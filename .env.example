# Firebase Web configuration (required for live dashboard)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only set true for intentional local/demo testing.
# Leave unset/false for the production IoT dashboard.
VITE_SMARTBIN_DEMO_MODE=false

# Vercel server-side variables (never expose these as VITE_* values)
# FIREBASE_SERVICE_ACCOUNT_JSON=<Firebase service-account JSON>
# IOT_DEVICE_API_KEY=<shared device telemetry key>
