{
  "//": [
    "SmartBin+ — Realtime Database security rules.",
    "",
    "These rules ARE the backend validation layer. They run on Google's",
    "servers and cannot be bypassed by a malicious or malfunctioning device,",
    "which is why telemetry validation lives here rather than in a serverless",
    "function the ESP32 could simply skip.",
    "",
    "They enforce:",
    "  · only the device service account may write telemetry",
    "  · only the four registered bin IDs exist",
    "  · distanceCm is either null (sensor fault) or a plausible number",
    "  · timestamp must be the SERVER clock, so a device with a wrong RTC",
    "    cannot appear permanently online",
    "  · devices cannot write bin metadata, alerts, users or config",
    "",
    "DEPLOY:  Firebase Console -> Realtime Database -> Rules -> paste -> Publish",
    "",
    "SETUP:   create an Email/Password user in Authentication for the",
    "         hardware (e.g. device@smartbin.local), copy its UID from the",
    "         Users tab, and paste it into DEVICE_UID below."
  ],

  "rules": {
    "$other": {
      ".read": false,
      ".write": false
    },

    "bins": {
      ".read": "auth != null",

      "$binId": {
        ".validate": "$binId === 'BIN-01' || $binId === 'BIN-02' || $binId === 'BIN-03' || $binId === 'BIN-04'",

        "meta": {
          "//": "Operators maintain metadata. Devices never write it.",
          ".write": "auth != null && auth.token.email_verified === true && auth.uid !== 'DEVICE_UID'",
          ".validate": "newData.hasChildren(['binId', 'label'])",
          "thresholdPct": {
            ".validate": "newData.isNumber() && newData.val() >= 50 && newData.val() <= 100"
          },
          "location": {
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" }
          },
          "$meta": { ".validate": true }
        },

        "live": {
          "//": "Telemetry. Written ONLY by the device service account.",
          ".write": "auth != null && auth.uid === 'DEVICE_UID'",
          ".validate": "newData.hasChildren(['deviceId', 'timestamp'])",

          "deviceId": {
            "//": "Must be the device registered for THIS bin — a device cannot report for another bin.",
            ".validate": "newData.isString() && newData.val() === 'ESP32-SMARTBIN-' + $binId.substring(4)"
          },

          "distanceCm": {
            "//": "null is legitimate and means a sensor fault. It must never be 0.",
            ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 400)"
          },

          "fillPct": {
            ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
          },

          "sensorOk": { ".validate": "newData.isBoolean()" },

          "timestamp": {
            "//": "Server clock only. Blocks a device from faking liveness with a future time.",
            ".validate": "newData.val() === now"
          },

          "rssi": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= -120 && newData.val() <= 0)" },
          "uptimeSec": { ".validate": "newData.val() === null || (newData.isNumber() && newData.val() >= 0)" },
          "firmware": { ".validate": "newData.val() === null || newData.isString()" },

          "$unknown": { ".validate": false }
        },

        "health": {
          ".write": "auth != null && auth.uid === 'DEVICE_UID'",
          "sensorOk": { ".validate": "newData.isBoolean()" },
          "wifiOk": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "newData.val() === now || newData.isNumber()" },
          "$other": { ".validate": true }
        },

        "$node": { ".validate": false }
      }
    },

    "logs": {
      ".read": "auth != null",
      "$binId": {
        ".write": "auth != null",
        "$pushId": {
          ".validate": "newData.hasChildren(['type', 'message'])",
          "type": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "message": { ".validate": "newData.isString() && newData.val().length <= 512" },
          "timestamp": { ".validate": "newData.val() === now || newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "alerts": {
      "//": "Raised and resolved by operators, not by devices.",
      ".read": "auth != null",
      ".write": "auth != null && auth.uid !== 'DEVICE_UID'",
      "$alertId": {
        ".validate": "newData.hasChildren(['binId', 'type', 'state'])",
        "state": { ".validate": "newData.val() === 'active' || newData.val() === 'acknowledged' || newData.val() === 'resolved'" }
      }
    },

    "trucks": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid !== 'DEVICE_UID'"
    },

    "routes": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid !== 'DEVICE_UID'"
    },

    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid !== 'DEVICE_UID'"
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
